# Copy to .env.local (git-ignored). Server-side only: nothing here reaches the browser.

# The OnePondy API, as reachable from the console server.
ONEPONDY_API_URL=http://localhost:5080

# Session cookies are marked Secure in production builds. Set to false only for a test server
# reached over plain HTTP; real deployments must use HTTPS (spec §12).
CONSOLE_SECURE_COOKIES=true

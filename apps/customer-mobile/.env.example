# Copy to .env and adjust. Expo exposes only variables prefixed with EXPO_PUBLIC_
# to the app, and they end up in the app bundle: never put secrets here (§8).

# API base URL for local development:
#   Android emulator -> http://10.0.2.2:5080
#   Physical phone   -> http://<your-PC-LAN-IP>:5080
#   API on IIS       -> http://<your-PC-LAN-IP>:<site-port> (see README, "Hosting the API on IIS")
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5080

# Where map pictures come from (OpenStreetMap by default). OpenStreetMap's public servers are for
# light use only: before a busy public launch, point this at a commercial tile provider or your own
# tile server. The address must contain {z}, {x} and {y}.
# EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
